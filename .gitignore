# Dependencies
node_modules/

# Build and test output
dist/
coverage/
*.tsbuildinfo

# Generated media stays out of Git (AGENTS.md). Committed fixtures such as
# golden frames and small reference assets are deliberately NOT matched here.
# Render output directories are added when the Producer defines them.
*.mp4
# Reports, measurements, and CLI output of the Producer and the browser tests (D28).
.kadrion-out/
# The pinned FFmpeg build, downloaded and verified by node --run ffmpeg:fetch (D29.1).
.kadrion-cache/

# Secrets and local environment
.env
.env.*
!.env.example

# Claude Code per-user settings. The shared .claude/ directory IS versioned.
.claude/settings.local.json

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
